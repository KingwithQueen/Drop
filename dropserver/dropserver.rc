#include <winres.h>
#include "resource.h"
#include "../dropcommon/version.h"
IDI_DROPSERVER_APP ICON "dropserver.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DROP_VERSION_RESOURCE
 PRODUCTVERSION DROP_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Drop Windows server\0"
            VALUE "FileVersion", DROP_VERSION_RESOURCE_STRING "\0"
            VALUE "InternalName", "dropserver\0"
            VALUE "OriginalFilename", "dropserver.exe\0"
            VALUE "ProductName", "dropserver\0"
            VALUE "ProductVersion", DROP_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
